{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A --env-file=.env --watch main.ts",
    "run": "deno run -A --env-file=.env queries.ts",
    "seed": "deno run -A --env-file=.env seed.ts",
    "test": "deno test -A --env-file=.env",
    "db:migrate": "deno run -A --env-file=.env npm:prisma@7 migrate dev",
    "db:generate": "deno run -A --env-file=.env npm:prisma@7 generate",
    "db:studio": "deno run -A --env-file=.env npm:prisma@7 studio",
    "db:push": "deno run -A --env-file=.env npm:prisma@7 db push"
  },
  "imports": {
    "@prisma/adapter-better-sqlite3": "npm:@prisma/adapter-better-sqlite3@^7.10.0",
    "@prisma/adapter-libsql": "npm:@prisma/adapter-libsql@^7.10.0",
    "@prisma/client": "npm:@prisma/client@^7.10.0",
    "@std/assert": "jsr:@std/assert@1",
    "dotenv": "npm:dotenv@^17.0.0",
    "libsql": "npm:libsql@^0.5.29",
    "prisma": "npm:prisma@^7.10.0"
  }
}
